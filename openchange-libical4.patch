@@ -203,6 +203,151 @@
 	return ICAL_CLASS_NONE;
 }
 
+#if ICAL_CHECK_VERSION(4, 0, 0)
+static const icalrecurrencetype_byrule oc_byrule[] = {
+	[OC_BY_MONTH]		= ICAL_BY_MONTH,
+	[OC_BY_MONTH_DAY]	= ICAL_BY_MONTH_DAY,
+	[OC_BY_DAY]		= ICAL_BY_DAY,
+	[OC_BY_SET_POS]		= ICAL_BY_SET_POS
+};
+
+struct icalrecurrencetype *oc_recur_new(void)
+{
+	return icalrecurrencetype_new();
+}
+
+void oc_recur_free(struct icalrecurrencetype *r)
+{
+	icalrecurrencetype_unref(r);
+}
+
+bool oc_recur_set_by(struct icalrecurrencetype *r, enum oc_recur_by by,
+		     const short *values, short count)
+{
+	icalrecurrencetype_byrule rule = oc_byrule[by];
+	short i;
+
+	if (!icalrecur_resize_by(&r->by[rule], count)) {
+		return false;
+	}
+	for (i = 0; i < count; i++) {
+		r->by[rule].data[i] = values[i];
+	}
+	return true;
+}
+
+short oc_recur_by_count(const struct icalrecurrencetype *r, enum oc_recur_by by)
+{
+	return r->by[oc_byrule[by]].size;
+}
+
+short oc_recur_by_value(const struct icalrecurrencetype *r, enum oc_recur_by by,
+			short idx)
+{
+	return r->by[oc_byrule[by]].data[idx];
+}
+
+short oc_recur_encode_day(enum icalrecurrencetype_weekday weekday, int position)
+{
+	return icalrecurrencetype_encode_day(weekday, position);
+}
+
+struct icaltriggertype oc_trigger_from_seconds(int seconds)
+{
+	return icaltriggertype_from_seconds(seconds);
+}
+#else
+/* libical 3.x: fixed arrays terminated by ICAL_RECURRENCE_ARRAY_MAX */
+static short *oc_by_array(struct icalrecurrencetype *r, enum oc_recur_by by,
+			  short *limit)
+{
+	switch (by) {
+	case OC_BY_MONTH:
+		*limit = ICAL_BY_MONTH_SIZE;
+		return r->by_month;
+	case OC_BY_MONTH_DAY:
+		*limit = ICAL_BY_MONTHDAY_SIZE;
+		return r->by_month_day;
+	case OC_BY_DAY:
+		*limit = ICAL_BY_DAY_SIZE;
+		return r->by_day;
+	case OC_BY_SET_POS:
+		*limit = ICAL_BY_SETPOS_SIZE;
+		return r->by_set_pos;
+	}
+	*limit = 0;
+	return NULL;
+}
+
+struct icalrecurrencetype *oc_recur_new(void)
+{
+	struct icalrecurrencetype *r = malloc(sizeof(*r));
+
+	if (r) {
+		icalrecurrencetype_clear(r);
+	}
+	return r;
+}
+
+void oc_recur_free(struct icalrecurrencetype *r)
+{
+	free(r);
+}
+
+bool oc_recur_set_by(struct icalrecurrencetype *r, enum oc_recur_by by,
+		     const short *values, short count)
+{
+	short limit;
+	short *array = oc_by_array(r, by, &limit);
+	short i;
+
+	if (!array || count >= limit) {
+		return false;
+	}
+	for (i = 0; i < count; i++) {
+		array[i] = values[i];
+	}
+	array[count] = ICAL_RECURRENCE_ARRAY_MAX;
+	return true;
+}
+
+short oc_recur_by_count(const struct icalrecurrencetype *r, enum oc_recur_by by)
+{
+	short limit;
+	short *array = oc_by_array((struct icalrecurrencetype *) r, by, &limit);
+	short count = 0;
+
+	if (!array) {
+		return 0;
+	}
+	while (count < limit && array[count] != ICAL_RECURRENCE_ARRAY_MAX) {
+		count++;
+	}
+	return count;
+}
+
+short oc_recur_by_value(const struct icalrecurrencetype *r, enum oc_recur_by by,
+			short idx)
+{
+	short limit;
+	short *array = oc_by_array((struct icalrecurrencetype *) r, by, &limit);
+
+	return array ? array[idx] : 0;
+}
+
+short oc_recur_encode_day(enum icalrecurrencetype_weekday weekday, int position)
+{
+	/* "weekday:pos" encoding: weekday + occurrence*8, negated to count back */
+	return (short)(position < 0 ? -(weekday - position * 8)
+				    : weekday + position * 8);
+}
+
+struct icaltriggertype oc_trigger_from_seconds(int seconds)
+{
+	return icaltriggertype_from_int(seconds);
+}
+#endif
