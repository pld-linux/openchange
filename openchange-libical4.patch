 #include <libical/ical.h>
 
+/* libical 4.0 made icalrecurrencetype a refcounted heap object and replaced the
+   fixed, ICAL_RECURRENCE_ARRAY_MAX-terminated BY* arrays with separately
+   allocated, explicitly sized ones. th still ships 3.0.x while th-ready has
+   4.0.x, so every recurrence access goes through the helpers below. */
+enum oc_recur_by {
+	OC_BY_MONTH,
+	OC_BY_MONTH_DAY,
+	OC_BY_DAY,
+	OC_BY_SET_POS
+};
+
+#if ICAL_CHECK_VERSION(4, 0, 0)
+/* pointer in, pointer out */
+#define OC_RECUR_ARG(r)		(r)
+#define OC_RECUR_REF(v)		(&(v))
+#define OC_RECUR_VALUE(x)	(*(x))
+#define oc_property_clone(p)	icalproperty_clone(p)
+#define oc_time_add(t, d)	icalduration_extend((t), (d))
+#else
+/* libical 3.x passes and returns the recurrence by value */
+#define OC_RECUR_ARG(r)		(*(r))
+#define OC_RECUR_REF(v)		(v)
+#define OC_RECUR_VALUE(x)	(x)
+#define oc_property_clone(p)	icalproperty_new_clone(p)
+#define oc_time_add(t, d)	icaltime_add((t), (d))
+#endif
